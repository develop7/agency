#!/usr/bin/env bash
# /do workflow's sync step — extracted to a script to collapse several Bash
# round-trips into one. Handles fetch, fast-forward, forge detection, dirty-
# tree hint, VCS backend detection, and initial results bookkeeping.
#
# Usage:
#   sync <vcs_enabled>
#     <vcs_enabled>  "true" or "false" — whether VCS operations are enabled
#
# Stdout (for the agent to parse):
#   forge=<github|bitbucket|unknown>
#   branch=<current branch name>
#   trunk=<origin HEAD ref name>
#   vcs_backend=<git|jj>

set -euo pipefail

vcs_enabled="${1:?Usage: sync <vcs_enabled>  (true|false)}"
case "$vcs_enabled" in
  true|false) ;;
  *) echo "sync: vcs_enabled must be 'true' or 'false', got '$vcs_enabled'" >&2; exit 2 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DO_RESULTS="$SCRIPT_DIR/../do-results"
VCS="$SCRIPT_DIR/../vcs"

startedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Detect VCS backend
vcs_backend="$("$VCS" detect | cut -d= -f2)"

# Fetch from origin
"$VCS" fetch

# For git: pin origin/HEAD after fetch
if [ "$vcs_backend" = "git" ]; then
  git remote set-head origin --auto >/dev/null
fi

# Fast-forward if behind upstream, unless --no-vcs
if [ "$vcs_enabled" = "true" ]; then
  if [ "$vcs_backend" = "git" ]; then
    if upstream="$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null)"; then
      behind="$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
      ahead="$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
      if [ "$behind" -gt 0 ] && [ "$ahead" -eq 0 ]; then
        git pull --ff-only
      fi
    fi
  else
    # jj: rebase onto updated trunk after fetch
    # jj rebase is idempotent — if already on trunk, it's a no-op
    trunk="$("$VCS" trunk)"
    jj rebase -d "$trunk" 2>/dev/null || true
  fi
fi

# Dirty-tree hint (no pause, just print)
# For jj: "dirty" means @ has changes compared to its parent — existing WIP
if [ "$vcs_enabled" = "true" ] && "$VCS" is-dirty; then
  echo "Dirty tree detected. Continuing will create a fresh branch on top of these changes. If you wanted the agent to extend your WIP in place without touching VCS, re-run with --no-vcs." >&2
fi

# Forge detection from origin URL
origin_url="$("$VCS" remote-url)"
case "$origin_url" in
  *github.com*)  forge="github" ;;
  *bitbucket.*)  forge="bitbucket" ;;
  *)             forge="unknown" ;;
esac

# Initialize results, stash /do-specific top-level fields via
# the generic `set` command, then record the sync step. Suppress do-results'
# stdout confirmations — sync emits its own forge/branch/trunk
# protocol below and shouldn't pollute it with do-results' echo lines.
"$DO_RESULTS" init >/dev/null
"$DO_RESULTS" set forge "$forge" >/dev/null
"$DO_RESULTS" set vcs_enabled "$vcs_enabled" >/dev/null
"$DO_RESULTS" set vcs_backend "$vcs_backend" >/dev/null
"$DO_RESULTS" step sync passed \
  "fetch ok; forge=$forge; vcs_backend=$vcs_backend; vcs_enabled=$vcs_enabled" \
  "$startedAt" now >/dev/null

# Emit structured facts the agent uses for downstream steps
branch="$("$VCS" current-branch)"
trunk="$("$VCS" trunk)"

echo "forge=$forge"
echo "branch=$branch"
echo "trunk=$trunk"
echo "vcs_backend=$vcs_backend"
