#!/usr/bin/env bash
# /do workflow's sync step — extracted to a script to collapse several Bash
# round-trips into one. Handles fetch, fast-forward, forge detection, dirty-
# tree hint, and initial results bookkeeping. VCS-agnostic: delegates to
# scripts/vcs-op.
#
# Usage:
#   sync <noVcs>
#     <noVcs>  "true" or "false" — whether --no-vcs was passed
#
# Stdout (for the agent to parse):
#   vcs=<jj|git|unknown>
#   forge=<github|bitbucket|unknown>
#   branch=<current branch name>
#   defaultBranch=<origin HEAD ref name>

set -euo pipefail

noVcs="${1:?Usage: sync <noVcs>  (true|false)}"
case "$noVcs" in
  true|false) ;;
  *) echo "sync: noVcs must be 'true' or 'false', got '$noVcs'" >&2; exit 2 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DO_RESULTS="$SCRIPT_DIR/../do-results"
VCS_OP="$SCRIPT_DIR/../vcs-op"

startedAt="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Detect VCS
vcs="$("$VCS_OP" detect)"

# Fetch
"$VCS_OP" fetch >/dev/null

# Pin origin/HEAD (git only; jj has no concept of origin/HEAD)
if [ "$vcs" = "git" ]; then
  git remote set-head origin --auto >/dev/null
fi

# Fast-forward if behind upstream, unless --no-vcs
if [ "$noVcs" = "false" ]; then
  case "$vcs" in
    git)
      if upstream="$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null)"; then
        behind="$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
        ahead="$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
        if [ "$behind" -gt 0 ] && [ "$ahead" -eq 0 ]; then
          git pull --ff-only
        fi
      fi
      ;;
    jj)
      # jj's git fetch already updates remote bookmarks. No pull needed.
      # If the user wants to move to the latest remote state, they do that
      # explicitly via `jj new <remote-bookmark>`.
      ;;
  esac
fi

# Dirty-tree hint (no pause, just print)
if [ "$noVcs" = "false" ] && "$VCS_OP" dirty; then
  echo "Dirty tree detected. Continuing will create a fresh branch on top of these changes. If you wanted the agent to extend your WIP in place without touching git, re-run with --no-vcs." >&2
fi

# Forge detection from origin URL
origin_url="$("$VCS_OP" remote-url)"
case "$origin_url" in
  *github.com*)  forge="github" ;;
  *bitbucket.*)  forge="bitbucket" ;;
  *)             forge="unknown" ;;
esac

# Initialize results, stash /do-specific top-level fields (vcs, forge, noVcs)
# via the generic `set` command, then record the sync step. Suppress do-results'
# stdout confirmations — sync emits its own vcs/forge/branch/defaultBranch
# protocol below and shouldn't pollute it with do-results' echo lines.
[ -f ".do-results.json" ] || "$DO_RESULTS" init >/dev/null
"$DO_RESULTS" set vcs "$vcs" >/dev/null
"$DO_RESULTS" set forge "$forge" >/dev/null
"$DO_RESULTS" set noVcs "$noVcs" >/dev/null
"$DO_RESULTS" step sync passed \
  "fetch ok; vcs=$vcs; forge=$forge; noVcs=$noVcs" \
  "$startedAt" now >/dev/null

# Emit structured facts the agent uses for downstream steps
branch="$("$VCS_OP" head-revision)"
default_ref="$("$VCS_OP" default-branch)"

echo "vcs=$vcs"
echo "forge=$forge"
echo "branch=$branch"
echo "defaultBranch=$default_ref"
