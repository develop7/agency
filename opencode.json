{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vcs": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "github:develop7/vcs-toolkit-rs/staging-good_stuff#vcs-mcp",
        "--",
        "--allow-tools",
        "repo_fetch,repo_commit,repo_push,repo_create_worktree,forge_pr_create,forge_pr_edit,forge_pr_comment,forge_pr_merge"
      ],
      "cwd": ".",
      "enabled": true
    }
  }
}
